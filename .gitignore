# 数据库与下载产物（含发票PDF，敏感）
data/

# Python 缓存与编译文件
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Python 虚拟环境
venv/
env/
ENV/
.venv

# 含授权码的账号配置（切勿上传/分享）
config/accounts.json
# 腾讯企业邮箱 API 凭证（含邮箱/密钥，切勿上传）
config/tencent.json
# 其他敏感配置（如果有）
config/secrets.json
config/*.local.json

# 日志文件
*.log
logs/

# 临时文件与缓存
__t/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# 导出临时文件
exports/

# 系统与工具产物（非项目源码）
.DS_Store
Thumbs.db
.agnes/
.workbuddy/
.trae/

# IDE 与编辑器配置
.vscode/
.idea/
*.sublime-*
.project
.pydevproject
.settings/

# PyInstaller 打包产物
dist/
build/
*.spec~

# 示例/样本数据（不上传）
sample/

# 测试覆盖率报告
.coverage
htmlcov/
*.cover

# 上传的临时文件缓存
uploads/
temp/
